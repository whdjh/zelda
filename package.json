{
  "name": "zelda-highpass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run check:content && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test src/lib/*.test.ts",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "check:content": "node scripts/check-content.ts",
    "check": "npm run check:docs && npm run check:content && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@seed-design/css": "^3.2.0",
    "@seed-design/react": "^3.2.0",
    "@seed-design/tailwind4-theme": "^3.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3"
  }
}
